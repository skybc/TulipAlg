<UserControl x:Class="TulipAlg.Views.CannyEdgeDetectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧参数输入区 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Canny亚像素边缘检测" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <!-- 图像加载 -->
                <GroupBox Header="图像加载" Margin="0,0,0,10">
                    <StackPanel>
                        <Button Content="加载图像" Command="{Binding LoadImageCommand}" Margin="0,5"/>
                        <Button Content="生成测试图像" Command="{Binding GenerateTestImageCommand}" Margin="0,5"/>
                        <TextBlock Text="{Binding ImageInfo}" TextWrapping="Wrap" Margin="0,5" FontSize="12"/>
                        
                        <!-- 显示原始图像的缩略图 -->
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="0,5" Height="150">
                            <Image Source="{Binding OriginalImage}" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 参数预设 -->
                <GroupBox Header="参数预设" Margin="0,0,0,10">
                    <StackPanel>
                        <Button Content="通用场景" Command="{Binding ApplyPresetCommand}" CommandParameter="Default" Margin="0,3"/>
                        <Button Content="噪声图像" Command="{Binding ApplyPresetCommand}" CommandParameter="Noisy" Margin="0,3"/>
                        <Button Content="清晰图像" Command="{Binding ApplyPresetCommand}" CommandParameter="Clear" Margin="0,3"/>
                        <Button Content="细节丰富" Command="{Binding ApplyPresetCommand}" CommandParameter="Detailed" Margin="0,3"/>
                        <Button Content="高质量边缘" Command="{Binding ApplyPresetCommand}" CommandParameter="HighQuality" Margin="0,3"/>
                    </StackPanel>
                </GroupBox>

                <!-- 检测参数 -->
                <GroupBox Header="检测参数" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="高斯滤波标准差 (Sigma):" Margin="0,5,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding Sigma}" Minimum="0" Maximum="3" Width="200" 
                                    TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Sigma, StringFormat={}{0:F1}}" Margin="10,0,0,0" VerticalAlignment="Center" Width="30"/>
                        </StackPanel>
                        <TextBlock Text="0 = 不滤波, 1-2 = 推荐范围" FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>

                        <TextBlock Text="高阈值 (High Threshold):" Margin="0,5,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding HighThreshold}" Minimum="5" Maximum="100" Width="200" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HighThreshold, StringFormat={}{0:F0}}" Margin="10,0,0,0" VerticalAlignment="Center" Width="30"/>
                        </StackPanel>

                        <TextBlock Text="低阈值 (Low Threshold):" Margin="0,5,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding LowThreshold}" Minimum="0" Maximum="50" Width="200" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LowThreshold, StringFormat={}{0:F0}}" Margin="10,0,0,0" VerticalAlignment="Center" Width="30"/>
                        </StackPanel>

                        <TextBlock Text="最小曲线长度:" Margin="0,5,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding MinCurveLength}" Minimum="1" Maximum="50" Width="200" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MinCurveLength}" Margin="10,0,0,0" VerticalAlignment="Center" Width="30"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 操作按钮 -->
                <GroupBox Header="操作" Margin="0,0,0,10">
                    <StackPanel>
                        <Button Content="执行边缘检测" Command="{Binding DetectEdgesCommand}" 
                                IsEnabled="{Binding IsImageLoaded}" Margin="0,5" 
                                Background="#4CAF50" Foreground="White" Height="35" FontWeight="Bold"/>
                        <Button Content="清除结果" Command="{Binding ClearResultsCommand}" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- 检测结果 -->
                <GroupBox Header="检测结果" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding DetectionResultText}" TextWrapping="Wrap" 
                                   Foreground="Blue" Margin="0,5" FontSize="12"/>
                    </StackPanel>
                </GroupBox>

                <!-- 统计信息 -->
                <GroupBox Header="统计信息" Margin="0,0,0,10" Visibility="{Binding IsDetectionComplete }">
                    <TextBlock Text="{Binding StatisticsInfo}" TextWrapping="Wrap" 
                               FontSize="12" Margin="0,5" FontFamily="Consolas"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧可视化区域 -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="10,0,0,0">
            <Grid>
                <Image x:Name="ResultImage" Stretch="Uniform" />
                <TextBlock x:Name="PlaceholderText" Text="边缘检测结果将显示在此处"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="16"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
