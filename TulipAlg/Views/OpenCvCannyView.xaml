<UserControl x:Class="TulipAlg.Views.OpenCvCannyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧参数控制区 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="OpenCV Canny边缘检测" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <!-- 图像加载 -->
                <GroupBox Header="图像加载" Margin="0,0,0,10">
                    <StackPanel>
                        <Button Content="加载图像" Command="{Binding LoadImageCommand}" Margin="0,5"/>
                        <Button Content="生成测试图像" Command="{Binding GenerateTestImageCommand}" Margin="0,5"/>
                        <TextBlock Text="{Binding ImageInfo}" TextWrapping="Wrap" Margin="0,5" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <!-- 参数预设 -->
                <GroupBox Header="参数预设" Margin="0,0,0,10">
                    <StackPanel>
                        <Button Content="灵敏 (低阈值)" Command="{Binding ApplyPresetCommand}" 
                                CommandParameter="Sensitive" Margin="0,3"/>
                        <Button Content="平衡 (推荐)" Command="{Binding ApplyPresetCommand}" 
                                CommandParameter="Balanced" Margin="0,3"/>
                        <Button Content="严格 (高阈值)" Command="{Binding ApplyPresetCommand}" 
                                CommandParameter="Strong" Margin="0,3"/>
                        <Button Content="高质量 (5×5 + L2)" Command="{Binding ApplyPresetCommand}" 
                                CommandParameter="HighQuality" Margin="0,3"/>
                        <Button Content="快速" Command="{Binding ApplyPresetCommand}" 
                                CommandParameter="Fast" Margin="0,3"/>
                    </StackPanel>
                </GroupBox>

                <!-- 检测参数 -->
                <GroupBox Header="检测参数" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="低阈值 (Threshold1):" Margin="0,5,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding Threshold1}" Minimum="0" Maximum="300" Width="200" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Threshold1, StringFormat={}{0:F0}}" Margin="10,0,0,0" 
                                      VerticalAlignment="Center" Width="40"/>
                        </StackPanel>
                        <TextBlock Text="用于边缘连接" FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>

                        <TextBlock Text="高阈值 (Threshold2):" Margin="0,5,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding Threshold2}" Minimum="0" Maximum="400" Width="200" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Threshold2, StringFormat={}{0:F0}}" Margin="10,0,0,0" 
                                      VerticalAlignment="Center" Width="40"/>
                        </StackPanel>
                        <TextBlock Text="用于初始边缘检测" FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>

                        <TextBlock Text="孔径大小 (Aperture Size):" Margin="0,5,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding ApertureSize}" Minimum="3" Maximum="7" Width="200" 
                                    TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ApertureSize}" Margin="10,0,0,0" 
                                      VerticalAlignment="Center" Width="40"/>
                        </StackPanel>
                        <TextBlock Text="Sobel算子大小 (3, 5, 7)" FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>

                        <CheckBox Content="使用L2梯度" IsChecked="{Binding UseL2Gradient}" Margin="0,5"/>
                        <TextBlock Text="更精确但速度较慢" FontSize="10" Foreground="Gray" Margin="20,0,0,5"/>

                        <CheckBox Content="自动检测" IsChecked="{Binding AutoDetect}" Margin="0,10,0,5" 
                                 FontWeight="Bold"/>
                        <TextBlock Text="参数改变时自动执行检测" FontSize="10" Foreground="Gray" Margin="20,0,0,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- 操作按钮 -->
                <GroupBox Header="操作" Margin="0,0,0,10">
                    <StackPanel>
                        <Button Content="执行边缘检测" Command="{Binding DetectEdgesCommand}" 
                                IsEnabled="{Binding IsImageLoaded}" Margin="0,5" 
                                Background="#2196F3" Foreground="White" Height="35" FontWeight="Bold"/>
                        <Button Content="清除结果" Command="{Binding ClearResultsCommand}" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- 检测结果信息 -->
                <GroupBox Header="检测结果" Margin="0,0,0,10">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding DetectionInfo}" TextWrapping="Wrap" 
                                  FontSize="11" FontFamily="Consolas" Margin="5"/>
                    </ScrollViewer>
                </GroupBox>

                <!-- 说明 -->
                <GroupBox Header="算法说明" Margin="0,0,0,10">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="5">
                        <Run Text="OpenCV Canny算法:"/><LineBreak/>
                        <Run Text="1. 高斯滤波降噪"/><LineBreak/>
                        <Run Text="2. 计算梯度强度和方向"/><LineBreak/>
                        <Run Text="3. 非极大值抑制"/><LineBreak/>
                        <Run Text="4. 双阈值筛选"/><LineBreak/>
                        <Run Text="5. 边缘连接追踪"/><LineBreak/><LineBreak/>
                        <Run Text="推荐阈值比例: 2:1 或 3:1" Foreground="Blue"/>
                    </TextBlock>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧图像显示区 -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 原始图像 -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                <Grid>
                    <Image Source="{Binding OriginalImageSource}" Stretch="Uniform"/>
                    <TextBlock Text="原始图像" 
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Background="#AA000000" Foreground="White" 
                              Padding="8,3" Margin="5" FontWeight="Bold"/>
                    <TextBlock Text="请加载或生成图像" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="Gray" FontSize="16"
                              Visibility="{Binding IsImageLoaded, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- 分隔符 -->
            <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" 
                         Background="Transparent" ResizeDirection="Rows"/>

            <!-- 边缘检测结果 -->
            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
                <Grid>
                    <Image Source="{Binding EdgeImageSource}" Stretch="Uniform"/>
                    <TextBlock Text="边缘检测结果" 
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Background="#AA000000" Foreground="White" 
                              Padding="8,3" Margin="5" FontWeight="Bold"/>
                    <TextBlock Text="边缘检测结果将显示在此处" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="Gray" FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EdgeImageSource}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
